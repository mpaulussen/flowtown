# Kopie nach /etc/flowtown.env, dann: sudo chmod 600 /etc/flowtown.env
MISTRAL_API_KEY=hier-deinen-schluessel-eintragen
MISTRAL_MODEL=mistral-small-latest
# zufälliger Wert, einmal erzeugen mit: openssl rand -hex 32
SALT=hier-zufallswert-eintragen
ALLOWED_ORIGINS=https://mpaulussen.github.io
DATA_DIR=/var/lib/flowtown
PORT=8787
HOST=127.0.0.1
K_MIN=5
KI_PER_DAY=20
# Verkehrslage vor der Fahrt. Autobahn-Meldungen laufen ohne Schlüssel.
# Für Stau und Störungen in der Stadt: kostenlosen Schlüssel bei HERE anlegen (platform.here.com), dann hier eintragen.
HERE_API_KEY=
LAGE_BBOX=8.38,51.90,8.70,52.12
LAGE_ROADS=A2,A33
LAGE_MIN=5
# Ziel prüfen: höchstens so viele Prüfungen (und Ortssuchen) je IP und Tag
ZIEL_PER_DAY=40
# Pilot: höchstens so viele Übertragungen je IP und Tag
PILOT_PER_DAY=300
# Umleitungen von moBiel: höchstens alle so viele Minuten lesen
MOBIEL_MIN=15
# Fahrplan: persönlicher Freigabe-Link zum DELFI-Datensatz „Deutschlandweite Sollfahrplandaten (GTFS)“ auf opendata-oepnv.de
DELFI_GTFS_URL=
# Betreiber im Fahrplan (Muster auf den Namen)
FAHRPLAN_AGENCY=moBiel
